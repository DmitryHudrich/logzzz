# CLICKHOUSE_PASSWORD ships with a weak default below for a fast first run — change it
# before exposing anything beyond localhost. This database stores imported credentials.
CLICKHOUSE_DB=logzz
CLICKHOUSE_APP_DB=logzz
CLICKHOUSE_USER=app
CLICKHOUSE_PASSWORD=app_password
CLICKHOUSE_HTTP_PORT=8123
# Host-side bind address for the published ClickHouse port. Defaults to loopback only;
# only widen this if you understand the exposure (see docker-compose.yml comments).
# CLICKHOUSE_HTTP_BIND_ADDR=127.0.0.1

TELEGRAM_BOT_TOKEN=
LOGZZ_POLL_INTERVAL_SECS=5
LOGZZ_TELEGRAM_MAX_RESULTS=50
# Comma-separated telegram user ids allowed to use the search bot. Strongly recommended:
# leaving this empty means ANY telegram user who finds the bot can query and download
# the full imported credential database. Get your id from e.g. @userinfobot on telegram.
LOGZZ_TELEGRAM_ALLOWED_USER_IDS=

DOWNLOADER_PEER_NAME=
DOWNLOADER_API_ID=
DOWNLOADER_API_HASH=
DOWNLOADER_POLL_INTERVAL_SECS=5
# Bearer token required on the downloader's /auth/* REST endpoints. Strongly
# recommended: without it, anyone who can reach DOWNLOADER_REST_PORT can hijack the
# telegram login flow. Generate one with e.g. `openssl rand -hex 32`.
DOWNLOADER_REST_API_TOKEN=
# Host-side bind address for the published downloader REST port. Defaults to loopback
# only; only widen this if DOWNLOADER_REST_API_TOKEN is set.
# DOWNLOADER_REST_BIND_ADDR=127.0.0.1
